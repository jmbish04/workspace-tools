{
  "name": "core-workspace-tools",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "wrangler dev",
    "migrate:DB:local": "wrangler d1 migrations apply DB --local",
    "migrate:DB:remote": "wrangler d1 migrations apply DB --remote",
    "migrate:DB_SPAM:local": "wrangler d1 migrations apply DB_SPAM --local",
    "migrate:DB_SPAM:remote": "wrangler d1 migrations apply DB_SPAM --remote",
    "migrate:all:local": "npm run migrate:DB:local && npm run migrate:DB_SPAM:local",
    "migrate:all:remote": "npm run migrate:DB:remote && npm run migrate:DB_SPAM:remote",
    "test": "tsx tests/run-tests.ts",
    "test:unit": "tsx tests/unit/cache.test.ts && tsx tests/unit/performance-monitor.test.ts",
    "test:integration": "tsx tests/integration/api.test.ts",
    "test:watch": "tsx --watch tests/run-tests.ts",
    "dry-run": "npx tsc --noEmit",
    "verify": "npm run dry-run && echo '✅ All checks passed - ready for commit!'",
    "verify-full": "npm run test && npm run dry-run && echo '✅ All tests and checks passed!'",
    "check:lock": "npm ls --json > /dev/null || (echo '❌ package-lock.json out of sync'; exit 1)",
    "migrate:db": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run check:lock && npm run migrate:db && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@google/generative-ai": "^0.24.1",
    "drizzle-orm": "^0.45.1",
    "google-auth-library": "^9.0.0",
    "googleapis": "^156.0.0",
    "hono": "^3.7.2",
    "kysely-d1": "^0.4.0",
    "openai": "^5.12.2"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^2.0.0",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.32.0"
  }
}
